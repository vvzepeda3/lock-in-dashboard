# Copy to server/.env for local development. Never commit the real .env.

# Local Docker Postgres from docker-compose.yml (hosted URLs get SSL automatically)
DATABASE_URL=postgres://lockin:lockin@localhost:5433/lockin

# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

NODE_ENV=development
PORT=4000
